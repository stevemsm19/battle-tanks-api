    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleTanks.Application\BattleTanks.Application.csproj" />
    <ProjectReference Include="..\BattleTanks.Infrastructure\BattleTanks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
